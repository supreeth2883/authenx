# AuthenX Production Environment Configuration
# Customize for your deployment environment

# Database
DATABASE_URL=postgresql://authenx:secure_password_here@postgres:5432/authenx

# Connector Database (ERP data)
CONNECTOR_DATABASE_URL=postgresql://authenx_connector:secure_password_here@postgres:5432/authenx_connector

# Redis
REDIS_URL=redis://:secure_redis_password@redis:6379

# Server
NODE_ENV=production
PORT=3001

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=86400

# CORS (specify exact domain, no wildcards)
CORS_ORIGIN=https://yourdomain.com

# Logging
LOG_LEVEL=info

# Session
SESSION_SECRET=your_session_secret_key_change_this_in_production

# Connector
CONNECTOR_URL=http://connector:3002

# Database Connection Pool (for production)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30000
DATABASE_STATEMENT_TIMEOUT=30000

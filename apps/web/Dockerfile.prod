# Web Frontend Production Dockerfile
# Multi-stage build for Next.js with optimized output

# ── Stage 1: Build ──────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@9

# Copy workspace dependency-resolution files
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/cloud-api/package.json apps/cloud-api/package.json
COPY apps/connector/package.json apps/connector/package.json
COPY apps/web/package.json        apps/web/package.json

# Use hoisted node_modules
RUN echo "node-linker=hoisted" > .npmrc && \
    echo "shamefully-hoist=true" >> .npmrc && \
    pnpm install --frozen-lockfile

# Copy web app source
COPY apps/web apps/web

# NEXT_PUBLIC_* vars must be available at build time (client components)
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Build Next.js application (standalone output)
RUN cd apps/web && /app/node_modules/.bin/next build

# Stage 2: Runtime
FROM node:22-alpine

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Next.js standalone output includes bundled node_modules
# In a monorepo, standalone replicates the directory structure
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/public ./apps/web/public

# Switch to non-root user
USER nodejs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "const h=require('http');h.get('http://localhost:3000/login',r=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

EXPOSE 3000

# Start Next.js in production mode
# In monorepo standalone output, server.js is at apps/web/server.js
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]

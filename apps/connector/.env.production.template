# AuthenX Connector Service Production Environment

# Server
NODE_ENV=production
PORT=3002

# Cloud API
CLOUD_API_URL=http://cloud-api:3001

# Connector Database (ERP data)
CONNECTOR_DATABASE_URL=postgresql://authenx_connector:secure_password_here@postgres:5432/authenx_connector

# ERP Config
ISSUER_CODE=TEST-COLLEGE
CONNECTOR_ADMIN_KEY=your_connector_admin_key_here

# Logging
LOG_LEVEL=info

# Connector Service Production Dockerfile
# Multi-stage build for optimized image size

# ── Stage 1: Build ──────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Prisma needs OpenSSL for engine detection on Alpine (musl)
RUN apk add --no-cache openssl

# Install pnpm
RUN npm install -g pnpm@9

# ── Build-time dummy DATABASE_URL ──────────────────────────────────
# Prisma schema validation (prisma generate / prisma validate) requires
# env("CONNECTOR_DATABASE_URL") to be resolvable. Render injects the
# real URL only at runtime, so we supply a harmless placeholder here.
# This is NEVER used for actual connections — it only satisfies Prisma's
# schema parser. Set it BEFORE pnpm install to also cover any
# @prisma/client postinstall lifecycle script.
ENV CONNECTOR_DATABASE_URL="postgresql://build:build@localhost:5432/build"

# Copy workspace dependency-resolution files
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/cloud-api/package.json apps/cloud-api/package.json
COPY apps/connector/package.json apps/connector/package.json
COPY apps/web/package.json        apps/web/package.json

# Use hoisted node_modules (TS moduleResolution: "nodenext" compatibility)
RUN echo "node-linker=hoisted" > .npmrc && \
    echo "shamefully-hoist=true" >> .npmrc && \
    pnpm install --frozen-lockfile

# Copy connector source (no .env files — excluded by .dockerignore)
COPY apps/connector apps/connector

# Generate Prisma client and build NestJS application
RUN cd apps/connector && npx prisma generate && /app/node_modules/.bin/nest build && cp -r src/generated dist/

# ── Stage 2: Runtime ────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Prisma query engine needs OpenSSL at runtime on Alpine
RUN apk add --no-cache openssl

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Copy node_modules and built output
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/apps/connector/package.json ./package.json

# Copy built output
COPY --from=builder --chown=nodejs:nodejs /app/apps/connector/dist ./dist

# Copy Prisma schema + migrations (needed at runtime for prisma migrate deploy)
COPY --from=builder --chown=nodejs:nodejs /app/apps/connector/prisma ./prisma

# KeysService writes to /app/.data at runtime — create with correct ownership
RUN mkdir -p /app/.data && chown nodejs:nodejs /app/.data

# Switch to non-root user
USER nodejs

EXPOSE 10000

# Start server: attempt migrations, then start NestJS regardless.
# If CONNECTOR_DATABASE_URL is missing or DB is unreachable, migrations
# will fail but the HTTP server will still bind the port so Render's
# health check passes. The app will log errors on first DB query.
CMD ["sh", "-c", "\
  if [ -n \"$CONNECTOR_DATABASE_URL\" ]; then \
    echo '==> Running Prisma migrations...' && \
    npx prisma migrate deploy --schema=prisma/schema.prisma || \
    echo '==> WARNING: prisma migrate deploy failed — check CONNECTOR_DATABASE_URL'; \
  else \
    echo '==> WARNING: CONNECTOR_DATABASE_URL is not set — skipping migrations'; \
    echo '==> Set it in Render Dashboard: authenx-connector → Environment → CONNECTOR_DATABASE_URL'; \
  fi && \
  echo \"==> Starting connector on port ${PORT:-10000}...\" && \
  exec node dist/main.js \
"]

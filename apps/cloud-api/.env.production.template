# AuthenX Cloud API Production Configuration Template
# Copy to .env.production and fill in actual values

# Database - use connection pooling in production
DATABASE_URL="postgresql://user:password@prod-host:5432/authenx?schema=public&connection_limit=10"

# Redis for caching and rate limiting
REDIS_URL="redis://:password@redis-host:6379/0"

# JWT - MUST be a secure random string (32+ chars minimum)
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_32_CHARS_MIN"
JWT_EXPIRATION="86400"

# Environment
NODE_ENV=production

# Server
PORT=3001

# CORS - specify exact domains, no wildcards
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Logging - info level in production for performance
LOG_LEVEL=info

# Session Secret
SESSION_SECRET="CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_STRING"

# Connector Service
CONNECTOR_URL="http://connector:3002"

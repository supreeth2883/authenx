# PRODUCTION CONFIGURATION
# Copy this to .env and fill in real values

# Database - use connection pooling in production
DATABASE_URL="postgresql://user:password@prod-host:5432/authenx?schema=public&connection_limit=10"

# JWT - MUST be a secure random string (32+ chars)
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_32_CHARS_MIN"
JWT_EXPIRES_IN="24h"

# Environment
NODE_ENV=production

# Server
PORT=3001

# CORS - production domains only, no wildcards
CORS_ORIGIN=https://authenx.io,https://www.authenx.io

# Logging - info level in production for performance
LOG_LEVEL=info
